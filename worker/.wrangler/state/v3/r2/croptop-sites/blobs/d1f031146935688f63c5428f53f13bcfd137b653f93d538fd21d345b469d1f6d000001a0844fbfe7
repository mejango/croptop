      else if (j == previousRow.postFrameReferences.length - 1 && postFrame.left >= postFrameToCheck.right + IndexCONFIG.horizontalMargin) {
        return candidatePostFrame ? candidatePostFrame.bottom : getTopTarget(postFrame, row - 1);
      }
