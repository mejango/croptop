  <div><div style="font-size:12px;opacity:.6">in that block</div><div id="gas-txs" style="font-size:22px">…</div></div>
  <div><div style="font-size:12px;opacity:.6">ETH</div><div id="gas-eth" style="font-size:22px">…</div></div>
